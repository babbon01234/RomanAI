# Copy to .env.local and fill in your key.
#
# The chat model is reached over an OpenAI-compatible API, so any gateway
# that speaks that format works. We use the Hack Club AI gateway, which
# fronts both OpenAI and Anthropic models behind one key.
#
# Leave AI_API_KEY blank and the app still runs: the answer layer falls back
# to "rehearsal" mode, which does real retrieval and real citations and
# quotes the material instead of writing prose. The student UI labels it.
AI_API_KEY=
# Defaults to https://ai.hackclub.com/proxy/v1 if blank.
AI_BASE_URL=
# Defaults to ~openai/gpt-mini-latest if blank.
# anthropic/claude-sonnet-5 also works on a Hack Club key.
AI_MODEL=

# Turso (libSQL). Leave both blank and the app uses a local SQLite file at
# data/app.db instead — that's the default for local dev. Required in
# production (Vercel's filesystem doesn't persist).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob, for uploaded lesson files (PDF/DOCX/PPTX). Auto-populated by
# Vercel when a Blob store is linked to the project; for local dev, copy it
# from the Vercel dashboard (Storage → your Blob store → .env.local tab).
BLOB_READ_WRITE_TOKEN=

# Canvas (Phase 2). Sandbox/test instances only — never a real school's.
# The domain is whatever is in your Canvas address bar; https:// is optional.
# Token: in Canvas, Account → Settings → New Access Token.
# Leave both blank and manual upload still works — the sync page says so.
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=

# Which Canvas user each real student account stands for (Phase 7 grade
# explanations). Match a student's real signed-up name; anyone left out
# simply has no submission to look up. Sandbox accounts only — never a real
# student's id. Example: CANVAS_STUDENT_IDS=Priya Patel:10421,Alex Chen:10422
CANVAS_STUDENT_IDS=

# Google OAuth (Phase 9). Create credentials in Google Cloud Console →
# APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <your-origin>/api/auth/google/callback
# (http://localhost:5880/api/auth/google/callback for local dev).
# Leave both blank and "Continue with Google" is hidden; email/password
# sign-in still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may create a *teacher* account. Student signup is open; teacher signup
# is not, because a teacher approves content and reads every student's
# question log.
#
#   local dev, blank  → teacher signup is open, so there's nothing to set up
#   production, blank → teacher signup is REFUSED (it fails closed on purpose,
#                       so a deploy can't be wide open by omission)
#
# REQUIRED in production. Make it long and random — it is the only thing
# standing between the open internet and a teacher account:
#   openssl rand -hex 16
TEACHER_SIGNUP_CODE=
