# Copy to .env.local and fill in your key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Canvas (Phase 2). Sandbox/test instances only — never a real school's.
# The domain is whatever is in your Canvas address bar; https:// is optional.
# Token: in Canvas, Account → Settings → New Access Token.
# Leave both blank and manual upload still works — the sync page says so.
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=

# Which Canvas user each fake student stands for (Phase 7 grade explanations).
# Names must be from the roster in lib/types.ts; anyone left out simply has no
# submission to look up. Sandbox accounts only — never a real student's id.
# Example: CANVAS_STUDENT_IDS=Priya:10421,Alex:10422
CANVAS_STUDENT_IDS=
